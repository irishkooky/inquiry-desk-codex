    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
